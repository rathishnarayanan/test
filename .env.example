# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sourcing:sourcing@db:5432/sourcing
SYNC_DATABASE_URL=postgresql://sourcing:sourcing@db:5432/sourcing

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── API ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Adapter selection (set to "mock" for Phase 1) ────────────────────────────
LLM_ADAPTER=mock
SOURCE_ADAPTERS=mock,github,stackoverflow,duckduckgo,devto,npm
CONTACT_ADAPTER=mock
OUTREACH_WHATSAPP_ADAPTER=mock
OUTREACH_EMAIL_ADAPTER=mock
TELEPHONY_ADAPTER=mock
INTERVIEW_ADAPTER=mock
EMBEDDING_ADAPTER=mock

# ── GitHub source adapter (optional; unauthenticated = 60 req/hour) ───────────
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ── Google Custom Search adapter (optional; 100 req/day free) ────────────────
# To enable: create a CSE at https://programmablesearchengine.google.com
# and an API key at https://console.cloud.google.com
# GOOGLE_CSE_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# GOOGLE_CSE_CX=XXXXXXXXXXXXXXXXX

# ── Stack Overflow source adapter (optional; no key = 300 req/day) ────────────
# STACKOVERFLOW_KEY=xxxxxxxxxxxxxxxxxxxx

# ── Juicebox adapter (Phase 2) ────────────────────────────────────────────────
# JUICEBOX_API_KEY=xxxxxxxxxxxxxxxxxxxx

# ── Apollo.io adapter (Phase 2) ───────────────────────────────────────────────
# APOLLO_API_KEY=xxxxxxxxxxxxxxxxxxxx

# ── LLM adapter (Phase 2) ─────────────────────────────────────────────────────
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# LLM_DEFAULT_MODEL=claude-haiku-4-5
# LLM_INTERVIEW_MODEL=claude-sonnet-4-5

# ── Gupshup WhatsApp adapter (Phase 2) ───────────────────────────────────────
# GUPSHUP_API_KEY=xxxxxxxxxxxxxxxxxxxx
# GUPSHUP_APP_ID=xxxxxxxxxxxxxxxxxxxx
# GUPSHUP_SOURCE_NUMBER=+91XXXXXXXXXX

# ── Plivo telephony adapter (Phase 2) ────────────────────────────────────────
# PLIVO_AUTH_ID=xxxxxxxxxxxxxxxxxxxx
# PLIVO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxx
# PLIVO_SOURCE_NUMBER=+91XXXXXXXXXX

# ── Outreach defaults ─────────────────────────────────────────────────────────
OUTREACH_ESCALATION_HOURS=48

# ── Workspace defaults ────────────────────────────────────────────────────────
DEFAULT_RETENTION_DAYS=90
DEFAULT_CONTACT_REVEAL_ENABLED=false
